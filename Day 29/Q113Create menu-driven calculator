//Q113Write a program to Create menu-driven calculator
#include <bits/stdc++.h>
using namespace std;

int main() {

    int choice;
    double num1, num2;

    do {
        cout << "\n===== MENU DRIVEN CALCULATOR =====\n";
        cout << "1. Addition\n";
        cout << "2. Subtraction\n";
        cout << "3. Multiplication\n";
        cout << "4. Division\n";
        cout << "5. Exit\n";
        cout << "Enter Your Choice: ";
        cin >> choice;

        switch (choice) {

        case 1:
            // Addition karna
            cout << "Enter Two Numbers: ";
            cin >> num1 >> num2;

            cout << "Result = " << num1 + num2 << endl;
            break;

        case 2:
            // Subtraction karna
            cout << "Enter Two Numbers: ";
            cin >> num1 >> num2;

            cout << "Result = " << num1 - num2 << endl;
            break;

        case 3:
            // Multiplication karna
            cout << "Enter Two Numbers: ";
            cin >> num1 >> num2;

            cout << "Result = " << num1 * num2 << endl;
            break;

        case 4:
            // Division karna
            cout << "Enter Two Numbers: ";
            cin >> num1 >> num2;

            if (num2 != 0)
                cout << "Result = " << num1 / num2 << endl;
            else
                cout << "Division by Zero is Not Allowed!" << endl;

            break;

        case 5:
            cout << "Exiting Calculator...\n";
            break;

        default:
            cout << "Invalid Choice! Please Try Again.\n";
        }

    } while (choice != 5);

    return 0;
}
