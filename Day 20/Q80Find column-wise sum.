#include <bits/stdc++.h>
using namespace std;

int main() {
    int r, c;
    
    // Matrix ka size input lena
    cout << "Enter rows and columns: ";
    cin >> r >> c;

    // 2D vector banana aur elements input lena
    vector<vector<int>> matrix(r, vector<int>(c));
    cout << "Enter elements of the matrix:" << endl;
    for (int i = 0; i < r; i++) {
        for (int j = 0; j < c; j++) {
            cin >> matrix[i][j];
        }
    }

    cout << "\nColumn-wise sums:" << endl;
    // Har ek column par iterate karna (Outer loop column ke liye hai)
    for (int j = 0; j < c; j++) {
        int colSum = 0; // Naye column ke liye sum zero set karna
        
        // Saari rows ke corresponding column element ko add karna
        for (int i = 0; i < r; i++) {
            colSum += matrix[i][j];
        }
        
        // Current column ka sum print karna
        cout << "Sum of Column " << j + 1 << ": " << colSum << endl;
    }

    return 0;
}
