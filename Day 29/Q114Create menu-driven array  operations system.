#include <bits/stdc++.h>
using namespace std;

int main() {

    int arr[100], n;
    int choice;

    cout << "Enter Size of Array: ";
    cin >> n;

    // Array elements input karna
    cout << "Enter Array Elements:\n";
    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    do {
        cout << "\n===== ARRAY OPERATIONS MENU =====\n";
        cout << "1. Display Array\n";
        cout << "2. Search Element\n";
        cout << "3. Find Maximum Element\n";
        cout << "4. Find Minimum Element\n";
        cout << "5. Calculate Sum\n";
        cout << "6. Exit\n";
        cout << "Enter Your Choice: ";
        cin >> choice;

        switch (choice) {

        case 1: {
            // Array display karna
            cout << "Array Elements: ";
            for (int i = 0; i < n; i++) {
                cout << arr[i] << " ";
            }
            cout << endl;
            break;
        }

        case 2: {
            // Element search karna
            int key;
            bool found = false;

            cout << "Enter Element to Search: ";
            cin >> key;

            for (int i = 0; i < n; i++) {
                if (arr[i] == key) {
                    cout << "Element Found at Position "
                         << i + 1 << endl;
                    found = true;
                    break;
                }
            }

            if (!found)
                cout << "Element Not Found!\n";

            break;
        }

        case 3: {
            // Maximum element find karna
            int maxElement = arr[0];

            for (int i = 1; i < n; i++) {
                if (arr[i] > maxElement)
                    maxElement = arr[i];
            }

            cout << "Maximum Element = "
                 << maxElement << endl;
            break;
        }

        case 4: {
            // Minimum element find karna
            int minElement = arr[0];

            for (int i = 1; i < n; i++) {
                if (arr[i] < minElement)
                    minElement = arr[i];
            }

            cout << "Minimum Element = "
                 << minElement << endl;
            break;
        }

        case 5: {
            // Array ka sum nikalna
            int sum = 0;

            for (int i = 0; i < n; i++) {
                sum += arr[i];
            }

            cout << "Sum of Elements = "
                 << sum << endl;
            break;
        }

        case 6:
            cout << "Exiting Program...\n";
            break;

        default:
            cout << "Invalid Choice!\n";
        }

    } while (choice != 6);

    return 0;
}
