#include <iostream>
#include <vector>
#include <string>
#include <iomanip>

using namespace std;

// Class representing a single Student
class Student {
private:
    int rollNumber;
    string name;
    int age;
    string course;

public:
    // Constructor
    Student(int roll, string studentName, int studentAge, string studentCourse) {
        rollNumber = roll;
        name = studentName;
        age = studentAge;
        course = studentCourse;
    }

    // Getter methods
    int getRollNumber() const { return rollNumber; }
    string getName() const { return name; }
    int getAge() const { return age; }
    string getCourse() const { return course; }

    // Setter methods for updates
    void setName(string newName) { name = newName; }
    void setAge(int newAge) { age = newAge; }
    void setCourse(string newCourse) { course = newCourse; }

    // Display individual student details
    void displayStudentRow() const {
        cout << left << setw(15) << rollNumber 
             << setw(25) << name 
             << setw(10) << age 
             << setw(20) << course << endl;
    }
};

// Class handling the Management System Operations
class StudentManagementSystem {
private:
    vector<Student> students;

    // Helper to find student index by roll number (-1 if not found)
    int findStudentIndex(int rollNumber) {
        for (size_t i = 0; i < students.size(); i++) {
            if (students[i].getRollNumber() == rollNumber) {
                return i;
            }
        }
        return -1;
    }

public:
    // 1. Add a New Student Record
    void addStudent() {
        int roll, age;
        string name, course;

        cout << "\nEnter Roll Number: ";
        cin >> roll;
        
        // Input validation: Check for duplicate roll number
        if (findStudentIndex(roll) != -1) {
            cout << "Error: Student with Roll Number " << roll << " already exists!\n";
            return;
        }

        cin.ignore(); // Clear newline buffer
        cout << "Enter Full Name: ";
        getline(cin, name);
        cout << "Enter Age: ";
        cin >> age;
        cin.ignore();
        cout << "Enter Course/Branch: ";
        getline(cin, course);

        // Add new student object to vector
        students.push_back(Student(roll, name, age, course));
        cout << "\nRecord added successfully!\n";
    }

    // 2. Display All Student Records
    void displayAllStudents() {
        if (students.empty()) {
            cout << "\nNo student records available.\n";
            return;
        }

        cout << "\n====================================================================\n";
        cout << left << setw(15) << "Roll Number" << setw(25) << "Name" << setw(10) << "Age" << setw(20) << "Course" << endl;
        cout << "====================================================================\n";
        for (const auto& student : students) {
            student.displayStudentRow();
        }
        cout << "====================================================================\n";
    }

    // 3. Search Student by Roll Number
    void searchStudent() {
        int roll;
        cout << "\nEnter Roll Number to search: ";
        cin >> roll;

        int index = findStudentIndex(roll);
        if (index == -1) {
            cout << "Student record not found.\n";
        } else {
            cout << "\nRecord Found:\n";
            cout << "------------------------------------\n";
            cout << "Roll Number : " << students[index].getRollNumber() << endl;
            cout << "Name        : " << students[index].getName() << endl;
            cout << "Age         : " << students[index].getAge() << endl;
            cout << "Course      : " << students[index].getCourse() << endl;
            cout << "------------------------------------\n";
        }
    }

    // 4. Update Student Record
    void updateStudent() {
        int roll;
        cout << "\nEnter Roll Number to update: ";
        cin >> roll;

        int index = findStudentIndex(roll);
        if (index == -1) {
            cout << "Student record not found.\n";
            return;
        }

        string newName, newCourse;
        int newAge;

        cin.ignore();
        cout << "Enter New Name (Current: " << students[index].getName() << "): ";
        getline(cin, newName);
        cout << "Enter New Age (Current: " << students[index].getAge() << "): ";
        cin >> newAge;
        cin.ignore();
        cout << "Enter New Course (Current: " << students[index].getCourse() << "): ";
        getline(cin, newCourse);

        // Update properties using setter methods
        students[index].setName(newName);
        students[index].setAge(newAge);
        students[index].setCourse(newCourse);

        cout << "\nRecord updated successfully!\n";
    }

    // 5. Delete Student Record
    void deleteStudent() {
        int roll;
        cout << "\nEnter Roll Number to delete: ";
        cin >> roll;

        int index = findStudentIndex(roll);
        if (index == -1) {
            cout << "Student record not found.\n";
            return;
        }

        // Erase record from vector
        students.erase(students.begin() + index);
        cout << "\nRecord deleted successfully!\n";
    }
};

// Main function to run the application console loop
int main() {
    StudentManagementSystem sms;
    int choice;

    do {
        cout << "\n*** STUDENT RECORD MANAGEMENT SYSTEM ***\n";
        cout << "1. Add Student Record\n";
        cout << "2. Display All Student Records\n";
        cout << "3. Search Student Record\n";
        cout << "4. Update Student Record\n";
        cout << "5. Delete Student Record\n";
        cout << "6. Exit Application\n";
        cout << "Enter your choice (1-6): ";
        cin >> choice;

        switch (choice) {
            case 1: sms.addStudent(); break;
            case 2: sms.displayAllStudents(); break;
            case 3: sms.searchStudent(); break;
            case 4: sms.updateStudent(); break;
            case 5: sms.deleteStudent(); break;
            case 6: cout << "\nExiting... Thank you for using the system!\n"; break;
            default: cout << "\nInvalid choice! Please choose between 1 and 6.\n";
        }
    } while (choice != 6);

    return 0;
}

