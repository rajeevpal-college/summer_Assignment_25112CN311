#include <bits/stdc++.h>
using namespace std;

int main() {
    char str[100];

    cout << "Enter a string: ";
    cin.getline(str, 100);

    int length = 0;

    // String ki length nikal rahe hain
    while (str[length] != '\0') {
        length++;
    }

    cout << "Reversed String: ";

    // Last character se first tak print karna
    for (int i = length - 1; i >= 0; i--) {
        cout << str[i];
    }

    cout << endl;

    return 0;
}
