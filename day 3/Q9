//prime number
#include <bits/stdc++.h>
using namespace std;

int main() {
    int N, count = 0;
cout << "Enter the number: ";
    cin >> N;
for (int i = 1; i <= N; i++) {
        if (N % i == 0) {
            count++;
        }
    }
    if (count == 2)
        cout << "Number is Prime";
    else
        cout << "Number is Not Prime";

    return 0;
}
