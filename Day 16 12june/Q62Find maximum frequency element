//Q62 Write a program to Find maximum frequency element
#include <bits/stdc++.h>
using namespace std;

int main() {
    int n, i, j;

    cout << "Enter size of array: ";
    cin >> n;

    int arr[n];

    cout << "Enter elements: ";
    for(i = 0; i < n; i++) {
        cin >> arr[i];
    }

    int maxFreq = 0;
    int maxElement;

    for(i = 0; i < n; i++) {
        int count = 1;

        for(j = i + 1; j < n; j++) {
            if(arr[i] == arr[j]) {
                count++;
            }
        }

        if(count > maxFreq) {
            maxFreq = count;
            maxElement = arr[i];
        }
    }

    cout << "Maximum frequency element is: " << maxElement << endl;
    cout << "Frequency is: " << maxFreq;

    return 0;
}
