// 55 Second largest element. 
#include<bits/stdc++.h>
using namespace std;

int main() {
    int i, n;
    cout << "Enter size of array: ";
    cin >> n;
    int arr[n];
    cout << "Enter elements of array: ";
    for(i = 0; i < n; i++) {
        cin >> arr[i];
    }

    sort(arr, arr + n);
    cout << "Second largest element = " << arr[n - 2];
    return 0;
}
