#include <bits/stdc++.h>
using namespace std;

int main() {
    char str[100];

    cout << "Enter a string: ";
    cin.getline(str, 100);

    // Har character ko check karna
    for (int i = 0; str[i] != '\0'; i++) {

        // Agar lowercase hai to uppercase me convert karo
        if (str[i] >= 'a' && str[i] <= 'z') {
            str[i] = str[i] - 32;
        }
    }

    cout << "Uppercase String: " << str << endl;

    return 0;
}
