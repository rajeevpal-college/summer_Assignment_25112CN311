//Q35 WAP a program to print repeated character pattern.
// A
// BB   
// CCC
// DDDD
// EEEEE
 
#include<bits/stdc++.h>
using namespace std;

int main() {
    for(char ch = 'A'; ch <= 'E'; ch++) {
        for(int j = 1; j <= ch - 'A' + 1; j++) {
            cout << ch;
        }
        cout << endl;
    }

    return 0;
}
