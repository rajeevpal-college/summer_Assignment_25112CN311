Write a program to Recursive reverse number
#include<bits/stdc++.h>
using namespace std;
int reverseNumber (int n , int digits)
{
if (n<10)
return n;
return (n%10)*pow(10,digits-1)+reverseNumber(n/10,digits-1);
}
int main ()
{
int n, temp, digits=0;
cin>>n;
temp=n;
while(temp)
{
digits++;
temp/=10;
}
cout<<reverseNumber(n,digits);
return 0;
}
