
//remove space from string 
# include<bits/stdc++.h>
using namespace std;
int main (){
char str [100];
cout << "enter  a string: ";
cin.getline(str,100);
int j=0;
//space ke alawa sab character ko aage shift karna 
for (int i=0; str[i] != '\0'; i++) {
if (str[i] != ' '){
str[j] =str[i];
j++;

}
}
//last me null character lagana 
str[j] = '\0' ;
cout <<"string after removal spaces: " << str << endl;
return 0;
}
