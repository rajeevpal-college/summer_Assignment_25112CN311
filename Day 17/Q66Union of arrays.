#include <bits/stdc++.h>
using namespace std;

// Function to print the union of two sorted arrays
void printUnion(int arr1[], int n1, int arr2[], int n2) {
    int i = 0; // Pointer for arr1
    int j = 0; // Pointer for arr2

    cout << "Union of Arrays: ";

    // Traverse both arrays
    while (i < n1 && j < n2) {
        
        // Skip duplicate elements in arr1
        while (i > 0 && i < n1 && arr1[i] == arr1[i - 1]) {
            i++;
        }
        // Skip duplicate elements in arr2
        while (j > 0 && j < n2 && arr2[j] == arr2[j - 1]) {
            j++;
        }

        // If one array ran out of elements during duplicate skipping, break
        if (i >= n1 || j >= n2) {
            break;
        }

        // Compare elements and print the smaller one
        if (arr1[i] < arr2[j]) {
            cout << arr1[i++] << " ";
        } else if (arr2[j] < arr1[i]) {
            cout << arr2[j++] << " ";
        } else {
            // If elements are equal, print once and move both pointers
            cout << arr1[i++] << " ";
            j++;
        }
    }

    // Print remaining elements of arr1 (skipping duplicates)
    while (i < n1) {
        if (i == 0 || arr1[i] != arr1[i - 1]) {
            cout << arr1[i] << " ";
        }
        i++;
    }

    // Print remaining elements of arr2 (skipping duplicates)
    while (j < n2) {
        if (j == 0 || arr2[j] != arr2[j - 1]) {
            cout << arr2[j] << " ";
        }
        j++;
    }
    cout << endl;
}

int main() {
    // Input arrays (Must be sorted)
    int arr1[] = {1, 2, 2, 4, 5, 6};
    int arr2[] = {2, 3, 5, 7};

    int n1 = sizeof(arr1) / sizeof(arr1[0]);
    int n2 = sizeof(arr2) / sizeof(arr2[0]);

    printUnion(arr1, n1, arr2, n2);

    return 0;
}
