//Q54 Write a program to Frequency of an element. 
#include<bits/stdc++.h>
using namespace std;

int main() {
    int n, i, element, count = 0;

    cout << "Enter size of array: ";
    cin >> n;
    int arr[n];
  cout << "Enter elements of array: ";
    for(i = 0; i < n; i++) {
        cin >> arr[i];
    }

    cout << "Enter element whose frequency is to be found: ";
    cin >> element;
  for(i = 0; i < n; i++) {
        if(arr[i] == element) {
            count++;
        }
    }

    cout << "Frequency of " << element << " = " << count;

    return 0;
}
