//Q76 Write a program to Find diagonal sum
#include<bits/stdc++.h>
using namespace std; 
int main (){
    int n;
    cout << "Enter the size of the square matrix: ";
    cin >> n;
    int a[100][100];
    cout << "Enter the elements of the matrix: ";
    for(int i = 0; i < n; i++){
        for(int j = 0; j < n; j++){
            cin >> a[i][j];
        }
    }
    //diagonal sum ka logic
    int primary_diagonal_sum = 0, secondary_diagonal_sum = 0;
    for(int i = 0; i < n; i++){
        primary_diagonal_sum += a[i][i];
        secondary_diagonal_sum += a[i][n - 1 - i];
    }
    //print diagonal sums
    cout << "The sum of the primary diagonal is: " << primary_diagonal_sum << endl;
    cout << "The sum of the secondary diagonal is: " << secondary_diagonal_sum << endl;
    return 0;
}
