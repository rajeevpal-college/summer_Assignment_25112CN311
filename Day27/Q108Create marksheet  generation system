#include<bits/stdc++.h>
using namespace std;

int main() {

    int choice;
    int count = 0;

    int rollNo[100];
    string name[100];

    float marks1[100];
    float marks2[100];
    float marks3[100];

    do {

        cout << "\n===== MARKSHEET GENERATION SYSTEM =====\n";
        cout << "1. Add Student Record\n";
        cout << "2. Generate Marksheet\n";
        cout << "3. Search Student\n";
        cout << "4. Delete Record\n";
        cout << "5. Exit\n";
        cout << "Enter Choice: ";
        cin >> choice;

        switch(choice) {

        case 1: {
            // Naya student record add karna
            cout << "\nEnter Roll Number: ";
            cin >> rollNo[count];

            cin.ignore();

            cout << "Enter Student Name: ";
            getline(cin, name[count]);

            cout << "Enter Marks of Subject 1: ";
            cin >> marks1[count];

            cout << "Enter Marks of Subject 2: ";
            cin >> marks2[count];

            cout << "Enter Marks of Subject 3: ";
            cin >> marks3[count];

            count++;

            cout << "Record Added Successfully!\n";
            break;
        }

        case 2: {
            // Sabhi students ki marksheet dikhana
            if(count == 0) {
                cout << "\nNo Records Found!\n";
            }
            else {

                for(int i = 0; i < count; i++) {

                    float total =
                    marks1[i] + marks2[i] + marks3[i];

                    float percentage = total / 3;

                    string grade;

                    if(percentage >= 90)
                        grade = "A+";
                    else if(percentage >= 75)
                        grade = "A";
                    else if(percentage >= 60)
                        grade = "B";
                    else if(percentage >= 40)
                        grade = "C";
                    else
                        grade = "F";

                    cout << "\n----- MARKSHEET -----\n";
                    cout << "Roll No    : "
                         << rollNo[i] << endl;
                    cout << "Name       : "
                         << name[i] << endl;
                    cout << "Subject 1  : "
                         << marks1[i] << endl;
                    cout << "Subject 2  : "
                         << marks2[i] << endl;
                    cout << "Subject 3  : "
                         << marks3[i] << endl;
                    cout << "Total      : "
                         << total << endl;
                    cout << "Percentage : "
                         << percentage << "%" << endl;
                    cout << "Grade      : "
                         << grade << endl;
                }
            }
            break;
        }

        case 3: {
            // Roll number se search karna
            int roll;
            bool found = false;

            cout << "Enter Roll Number: ";
            cin >> roll;

            for(int i = 0; i < count; i++) {

                if(rollNo[i] == roll) {

                    float total =
                    marks1[i] + marks2[i] + marks3[i];

                    float percentage = total / 3;

                    cout << "\nRecord Found\n";
                    cout << "Name       : "
                         << name[i] << endl;
                    cout << "Total      : "
                         << total << endl;
                    cout << "Percentage : "
                         << percentage << "%" << endl;

                    found = true;
                    break;
                }
            }

            if(!found)
                cout << "Record Not Found!\n";

            break;
        }

        case 4: {
            // Record delete karna
            int roll;
            bool found = false;

            cout << "Enter Roll Number to Delete: ";
            cin >> roll;

            for(int i = 0; i < count; i++) {

                if(rollNo[i] == roll) {

                    for(int j = i; j < count - 1; j++) {

                        rollNo[j] = rollNo[j + 1];
                        name[j] = name[j + 1];
                        marks1[j] = marks1[j + 1];
                        marks2[j] = marks2[j + 1];
                        marks3[j] = marks3[j + 1];
                    }

                    count--;

                    cout << "Record Deleted Successfully!\n";

                    found = true;
                    break;
                }
            }

            if(!found)
                cout << "Record Not Found!\n";

            break;
        }

        case 5:
            cout << "Exiting Program...\n";
            break;

        default:
            cout << "Invalid Choice!\n";
        }

    } while(choice != 5);

    return 0;
}
