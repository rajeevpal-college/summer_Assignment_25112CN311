//74Write a program to Subtract matrices.
#include<bits/stdc++.h>
using namespace std;
int main (){
    int n, m;
    //take input of number of rows and columns>take input of two matrices>logic of subtraction of matrices
    //>print difference of matrices
    cout << "Enter the number of rows and columns: ";
    cin >> n >> m;
    int a[100][100], b[100][100], c[100][100];
    //pehle matrix ka input lo
    cout << "Enter the elements of the first matrix: ";
    for(int i = 0; i < n; i++){
        for(int j = 0; j < m; j++){
            cin >> a[i][j];
        }
    }
    //secon matrix ka input lo
    cout << "Enter the elements of the second matrix: ";
    for(int i = 0; i < n; i++){
        for(int j = 0; j < m; j++){
            cin >> b[i][j];
        }
    }
    //subtraction ka logic
    for(int i = 0; i < n; i++){
        for(int j = 0; j < m; j++){
            c[i][j] = a[i][j] - b[i][j];
        }
    }
    //print difference of matrices
    cout << "The difference of the two matrices is: " << endl;
    for(int i = 0; i < n; i++){
        for(int j = 0; j < m; j++){
            cout << c[i][j] << " ";
        }
        cout << endl;
    }
    return 0;
}
