#include <bits/stdc++.h>
using namespace std;

int main() {
    int r, c;
    
    // Matrix ka size input lena
    cout << "Enter rows and columns: ";
    cin >> r >> c;

    // 2D vector banana aur elements input lena
    vector<vector<int>> matrix(r, vector<int>(c));
    cout << "Enter elements of the matrix:" << endl;
    for (int i = 0; i < r; i++) {
        for (int j = 0; j < c; j++) {
            cin >> matrix[i][j];
        }
    }

    cout << "\nRow-wise sums:" << endl;
    // Har ek row par iterate karna
    for (int i = 0; i < r; i++) {
        int rowSum = 0; // Nayi row ke liye sum zero set karna
        
        // Current row ke saare columns ka sum nikalna
        for (int j = 0; j < c; j++) {
            rowSum += matrix[i][j];
        }
        
        // Current row ka sum print karna
        cout << "Sum of Row " << i + 1 << ": " << rowSum << endl;
    }

    return 0;
}
