//Q73Write a program to Add matrices.
//matrix ka input lo => 
#include<bits/stdc++.h>
using namespace std;
int main (){
    int n, m;
    

    //pehle number of rows and columns ka input lo
    cout << "Enter the number of rows and columns: ";
    cin >> n >> m;
    int a[100][100], b[100][100], c[100][100];
    cout << "Enter the elements of the first matrix: ";
    for(int i = 0; i < n; i++){
        for(int j = 0; j < m; j++){
            cin >> a[i][j];
        }
    }
    //dusre matrix ka input lo
    cout << "Enter the elements of the second matrix: ";
    for(int i = 0; i < n; i++){
        for(int j = 0; j < m; j++){
            cin >> b[i][j];
        }
    }
    //addition ka logic
    for(int i = 0; i < n; i++){
        for(int j = 0; j < m; j++){
            c[i][j] = a[i][j] + b[i][j];
        }
    }
    //print sum of matrices         
    cout << "The sum of the two matrices is: " << endl;
    for(int i = 0; i < n; i++){
        for(int j = 0; j < m; j++){
            cout << c[i][j] << " ";
        }
        cout << endl;
    }
    return 0;
}
