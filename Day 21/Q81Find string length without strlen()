#include <bits/stdc++.h>
using namespace std;

int main() {
    char str[100];

    cout << "Enter a string: ";
    cin.getline(str, 100);

    int length = 0;

    // Jab tak null character na mile, count badhate raho
    while (str[length] != '\0') {
        length++;
    }

    cout << "Length of string = " << length << endl;

    return 0;
}
