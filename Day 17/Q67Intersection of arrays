Q66 Write a program to Intersection of arrays
#include <bits/stdc++.h>
using namespace std;

// Function to print the intersection of two sorted arrays
void printIntersection(int arr1[], int n1, int arr2[], int n2) {
    int i = 0; // Pointer for arr1
    int j = 0; // Pointer for arr2
    bool found = false;

    cout << "Intersection of Arrays: ";

    // Traverse both arrays
    while (i < n1 && j < n2) {
        
        // Skip duplicate elements in arr1 to ensure unique output
        while (i > 0 && i < n1 && arr1[i] == arr1[i - 1]) {
            i++;
        }
        // Skip duplicate elements in arr2 to ensure unique output
        while (j > 0 && j < n2 && arr2[j] == arr2[j - 1]) {
            j++;
        }

        // If either array runs out of elements during duplicate skipping, stop
        if (i >= n1 || j >= n2) {
            break;
        }

        // If element in arr1 is smaller, move the arr1 pointer forward
        if (arr1[i] < arr2[j]) {
            i++;
        } 
        // If element in arr2 is smaller, move the arr2 pointer forward
        else if (arr2[j] < arr1[i]) {
            j++;
        } 
        // If elements are equal, it is a common element
        else {
            cout << arr1[i] << " ";
            found = true;
            i++;
            j++;
        }
    }
    
    if (!found) {
        cout << "No common elements found.";
    }
    cout << endl;
}

int main() {
    // Input arrays (Must be sorted)
    int arr1[] = {1, 2, 2, 4, 5, 6};
    int arr2[] = {2, 2, 3, 5, 7};

    int n1 = sizeof(arr1) / sizeof(arr1);
    int n2 = sizeof(arr2) / sizeof(arr2);

    printIntersection(arr1, n1, arr2, n2);

    return 0;
}
