#include<bits/stdc++.h>
using namespace std;
int main(){
    int n,d=0,rev=0,n1;
    cout<<"enter number";
    cin>>n;
     n1=n;
    //while(n>=0){
    while(n>0){
        d=n%10;
        rev=rev*10+d;
        n=n/10;
    }
    // if (n1=n){
    if (n1==rev){

        cout<<"number is palindrome";
    }                                     //else statement
    else{cout<<"not palindrome";}
    return 0;
}
