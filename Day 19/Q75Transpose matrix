//Q75 Write a program to Transpose matrix.
#include<bits/stdc++.h>
using namespace std;
int main (){
    int n, m;
    cout << "Enter the number of rows and columns: ";
    cin >> n >> m;
    int a[100][100], b[100][100];
    cout << "Enter the elements of the matrix: ";
    for(int i = 0; i < n; i++){
        for(int j = 0; j < m; j++){
            cin >> a[i][j];
        }
    }
    //transpose ka logic
    for(int i = 0; i < n; i++){
        for(int j = 0; j < m; j++){
            b[j][i] = a[i][j];
        }
    }
    //print transposed matrix
    cout << "The transposed matrix is: " << endl;
    for(int i = 0; i < m; i++){
        for(int j = 0; j < n; j++){
            cout << b[i][j] << " ";
        }
        cout << endl;
    }
    return 0;
}


