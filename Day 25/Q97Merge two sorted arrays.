
#include <bits/stdc++.h>
using namespace std;
int main(){
    int arr1[100],arr2[100],merged[200];
    int n1, n2;
    cout << "enter size of first array ";
    cin>>n1;
    cout<<"enter size of second array ";
    cin>>n2;
    cout<<"enter sorted element of first array ";
    for(int i=0;i<n1;i++){
        cin>>arr1[i];
    }
     cout<<"enter sorted second array: ";
     for(int i=0;i<n2;i++){
        cin>>arr2[i];
     }
   
     int i=0,j=0,k=0;
//dono array ke current element compare karo
     while (i<n1&&j<n2){
        if(arr1[i]<arr2[j]){
            merged[k]=arr1[i];
            i++;}
            else{
                merged[k]=arr2[j];
                j++;}
                k++;
            }
            //agar arr1 me element bach gaye hon
                while(i<n1){
                    merged[k]=arr1[i];
                    i++;
                    k++;
                }
                //agar arr2 me element bach gaye hon
                while(j<n2){
                    merged[k]=arr2[j];
                    j++;
                    k++;

                }
                    cout<<"merged sorted array: ";
                    for (int i=0;i<n1+n2;i++){
                        cout<<merged[i]<<" ";
                    }
                    return 0;
                }
 
            
