//Q117 Write a program to Create student record system using arrays and strings
#include <bits/stdc++.h>
using namespace std;

int main() {
    int choice;
    int count = 0;

    int roll[100];
    int age[100];
    string name[100];
    string course[100];

    do {
        cout << "\n===== STUDENT RECORD SYSTEM =====\n";
        cout << "1. Add Student\n";
        cout << "2. Display Students\n";
        cout << "3. Search Student\n";
        cout << "4. Update Student\n";
        cout << "5. Delete Student\n";
        cout << "6. Exit\n";
        cout << "Enter Choice: ";
        cin >> choice;

        switch (choice) {

        case 1: {
            // Naya student add karna
            cout << "\nEnter Roll Number: ";
            cin >> roll[count];

            cin.ignore();

            cout << "Enter Name: ";
            getline(cin, name[count]);

            cout << "Enter Age: ";
            cin >> age[count];

            cin.ignore();

            cout << "Enter Course: ";
            getline(cin, course[count]);

            count++;

            cout << "Record Added Successfully!\n";
            break;
        }

        case 2: {
            // Sabhi records display karna
            if (count == 0) {
                cout << "\nNo Records Found!\n";
            }
            else {
                cout << "\n----- Student Records -----\n";

                for (int i = 0; i < count; i++) {
                    cout << "\nStudent " << i + 1 << endl;
                    cout << "Roll No : " << roll[i] << endl;
                    cout << "Name    : " << name[i] << endl;
                    cout << "Age     : " << age[i] << endl;
                    cout << "Course  : " << course[i] << endl;
                }
            }
            break;
        }

        case 3: {
            // Roll number se search karna
            int r;
            bool found = false;

            cout << "Enter Roll Number to Search: ";
            cin >> r;

            for (int i = 0; i < count; i++) {
                if (roll[i] == r) {
                    cout << "\nRecord Found\n";
                    cout << "Roll No : " << roll[i] << endl;
                    cout << "Name    : " << name[i] << endl;
                    cout << "Age     : " << age[i] << endl;
                    cout << "Course  : " << course[i] << endl;

                    found = true;
                    break;
                }
            }

            if (!found)
                cout << "Record Not Found!\n";

            break;
        }

        case 4: {
            // Student record update karna
            int r;
            bool found = false;

            cout << "Enter Roll Number to Update: ";
            cin >> r;

            for (int i = 0; i < count; i++) {
                if (roll[i] == r) {

                    cin.ignore();

                    cout << "Enter New Name: ";
                    getline(cin, name[i]);

                    cout << "Enter New Age: ";
                    cin >> age[i];

                    cin.ignore();

                    cout << "Enter New Course: ";
                    getline(cin, course[i]);

                    cout << "Record Updated Successfully!\n";

                    found = true;
                    break;
                }
            }

            if (!found)
                cout << "Record Not Found!\n";

            break;
        }

        case 5: {
            // Record delete karna
            int r;
            bool found = false;

            cout << "Enter Roll Number to Delete: ";
            cin >> r;

            for (int i = 0; i < count; i++) {

                if (roll[i] == r) {

                    for (int j = i; j < count - 1; j++) {
                        roll[j] = roll[j + 1];
                        age[j] = age[j + 1];
                        name[j] = name[j + 1];
                        course[j] = course[j + 1];
                    }

                    count--;

                    cout << "Record Deleted Successfully!\n";

                    found = true;
                    break;
                }
            }

            if (!found)
                cout << "Record Not Found!\n";

            break;
        }

        case 6:
            cout << "Exiting Program...\n";
            break;

        default:
            cout << "Invalid Choice!\n";
        }

    } while (choice != 6);

    return 0;
}

