#include <bits/stdc++.h>
using namespace std;

int main() {
    char str[100];

    cout << "Enter a string: ";
    cin.getline(str, 100);

    int vowels = 0, consonants = 0;

    // String ke har character ko check karna
    for (int i = 0; str[i] != '\0'; i++) {

        // Sirf alphabet check karenge
        if (isalpha(str[i])) {

            char ch = tolower(str[i]);

            // Vowel check
            if (ch == 'a' || ch == 'e' || ch == 'i' ||
                ch == 'o' || ch == 'u') {
                vowels++;
            }
            else {
                consonants++;
            }
        }
    }

    cout << "Vowels = " << vowels << endl;
    cout << "Consonants = " << consonants << endl;

    return 0;
}
